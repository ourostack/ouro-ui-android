<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: a text-to-speech engine that records what a screen reader sends it, so CI can assert TalkBack's own speech. -->
        <service
            android:name=".speech.RecordingTtsService"
            android:exported="true"
            android:label="Recording speech">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Debug builds only: dispatches the swipe gestures that make TalkBack move to the next or previous node. -->
        <service
            android:name=".speech.SwipeService"
            android:exported="true"
            android:label="Swipe dispatcher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/swipe_service" />
        </service>
    </application>
</manifest>
